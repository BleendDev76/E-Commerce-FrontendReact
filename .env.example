# ===================================================
# Variables de Entorno - Frontend (Vite)
# ===================================================
# En Vite, solo las variables que empiezan con VITE_ son expuestas al cliente (código JS).
# 
# En desarrollo:
#   Apunta al backend local en Spring Boot (puerto 8081)
# En producción (Vercel, Netlify, Cloudflare Pages):
#   Configurar en el panel de control del proveedor la URL pública del backend en Render:
#   Ej: https://mi-backend.onrender.com/api
# ===================================================
VITE_API_URL=http://localhost:8081/api
